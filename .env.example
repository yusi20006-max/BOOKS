# Local-only configuration. Never commit real secrets.
BOOKS_DB_PATH=data/books.sqlite3
BOOKS_HOST=127.0.0.1
BOOKS_PORT=8501
BOOKS_REQUEST_TIMEOUT_SECONDS=10
# User-Agent sent to provider APIs (matches the config.py default).
BOOKS_USER_AGENT=BOOKS/0.1 (+https://github.com/yusi20006-max/BOOKS)
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# AI assistant («دستیار هوشمند») gateways. The local gateway is the default;
# the fallback is only used when BOOKS_AI_FALLBACK_BASE_URL is set.
BOOKS_AI_BASE_URL=http://127.0.0.1:8000/v1
BOOKS_AI_MODEL=local
BOOKS_AI_API_KEY=
BOOKS_AI_FALLBACK_BASE_URL=
BOOKS_AI_FALLBACK_MODEL=
BOOKS_AI_FALLBACK_API_KEY=

# Optional provider credential; leave empty when not required.
GOOGLE_BOOKS_API_KEY=

# API bearer token for the REST/MCP/sync runtime (python -m books.runtime).
# Required when binding a non-loopback BOOKS_HOST; the runtime refuses to start
# on a routable interface without it. Leave empty for loopback-only use.
BOOKS_API_TOKEN=

# Explicit, insecure opt-out of the non-loopback token requirement above.
# Only set this if you intentionally want an unauthenticated API on a routable
# interface (the runtime logs a warning at startup). Leave empty otherwise.
BOOKS_ALLOW_UNAUTHENTICATED=
